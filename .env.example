# Copy this file to ".env" for local development. Never commit ".env".
# On Streamlit Community Cloud, put the key in App settings > Secrets instead.
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# Optional: recipient shown on the Contact page. Messages open in the visitor's email app.
CONTACT_EMAIL=

# Optional: configure SMTP to send contact form submissions directly.
# Without SMTP_HOST, the app prepares a draft in the visitor's email app instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=15

# Optional: silences ChromaDB telemetry error messages in the console.
ANONYMIZED_TELEMETRY=False

# Optional: hides the harmless Hugging Face symlink warning on Windows.
HF_HUB_DISABLE_SYMLINKS_WARNING=1
